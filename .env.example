# ==============================================================================
# EMERGENCY PASSPORT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Groq High-Speed AI Triage Key (Free-tier friendly, sub-second inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. AWS Credentials (Required for AWS Cloud Deployment)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1

# 3. Optional Supabase Cloud Database Sync
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-or-anon-key
